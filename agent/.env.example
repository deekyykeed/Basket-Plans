# Copy to .env and fill in. Never commit the real .env file.

# Server-side only — this is what actually calls Claude. Never ship this
# to a browser or anything a customer's phone can see.
ANTHROPIC_API_KEY=

# Same Supabase project as the rest of Basket Plans.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# The shared secret resolve-basket checks for (see
# supabase/functions/resolve-basket and WHATSAPP_BASKET_HANDOFF.md).
BASKET_AGENT_KEY=

# Wherever the actual WhatsApp Cloud API credentials live — plug into
# src/sendWhatsApp.ts once you wire up the real send call.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
